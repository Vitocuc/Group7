#!/usr/bin/expect -f

# Automated LPSPI test using expect
# This script automatically tests the LPSPI loopback functionality

set timeout 10
spawn bash -c "cd /home/iaco/Polito/CAOS/Group7/qemu/build && ./qemu-system-arm -M nxps32k358evb -nographic -kernel ../../Demo_FreeRTOS.elf -serial none -serial none -serial none -serial mon:stdio -d guest_errors"

# Wait for QEMU to start
sleep 3

# Enter monitor mode (Ctrl+A, then C)
send "\x01c"
expect "(qemu)"

puts "\n=== AUTOMATED LPSPI TEST ==="

# Test 1: Check LPSPI registers
puts "1. Checking LPSPI VERID register..."
send "x/1wx 0x40330000\r"
expect "(qemu)"

puts "2. Checking LPSPI PARAM register..."
send "x/1wx 0x40330004\r"
expect "(qemu)"

# Test 2: Reset LPSPI
puts "3. Resetting LPSPI..."
send "x 0x40330010 0x2\r"
expect "(qemu)"
send "x 0x40330010 0x0\r"
expect "(qemu)"

# Test 3: Configure loopback mode
puts "4. Configuring LPSPI for loopback mode..."
send "x 0x40330024 0x01000001\r"
expect "(qemu)"

# Test 4: Enable module
puts "5. Enabling LPSPI module..."
send "x 0x40330010 0x1\r"
expect "(qemu)"

# Test 5: Verify configuration
puts "6. Verifying CFGR1 register (should show loopback enabled)..."
send "x/1wx 0x40330024\r"
expect "(qemu)"

# Test 6: Configure for 8-bit transfer and test loopback
puts "7. Testing 8-bit loopback transfer..."

# Configure TCR for 8-bit frame
send "x 0x40330060 0x7\r"
expect "(qemu)"

puts "8. Sending test value 0xAB..."
send "x 0x40330064 0xAB\r"
expect "(qemu)"

puts "9. Reading received data (should be 0xAB if loopback works)..."
send "x/1wx 0x40330074\r"
expect "(qemu)"

# Test with different values
puts "10. Testing with 0x55..."
send "x 0x40330060 0x7\r"
expect "(qemu)"
send "x 0x40330064 0x55\r"
expect "(qemu)"
send "x/1wx 0x40330074\r"
expect "(qemu)"

puts "11. Testing with 0xAA..."
send "x 0x40330060 0x7\r"
expect "(qemu)"
send "x 0x40330064 0xAA\r"
expect "(qemu)"
send "x/1wx 0x40330074\r"
expect "(qemu)"

puts "\n=== TEST COMPLETATO ==="
puts "Se vedi i valori inviati == valori ricevuti, il loopback funziona!"

# Exit
send "quit\r"
expect eof
